<Window
	x:Class="ScrapRenamer.SettingsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="設定"
	Width="400"
	Height="320"
	ResizeMode="CanResize"
	WindowStartupLocation="CenterOwner"
	ThemeMode="System">

	<Grid Margin="16">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="12"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="12"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- テーマ -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="80"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="テーマ"/>

			<ComboBox
				Grid.Column="2"
				SelectedIndex="0"
				x:Name="ThemeComboBox">
			</ComboBox>
		</Grid>

		<!-- フォント -->
		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="80"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="フォント"/>

			<ComboBox
				Grid.Column="1"
				x:Name="FontFamilyComboBox"/>

		</Grid>

		<!-- サイズ -->
		<Grid Grid.Row="4">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="80"/>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="サイズ"/>

			<ComboBox
				Grid.Column="1"
				x:Name="FontSizeComboBox"
				IsEditable="True"/>

		</Grid>

		<!-- サンプル -->
		<!--
		<GroupBox
			Grid.Row="6"
			Grid.RowSpan="2"
			Header="サンプル"
			Margin="0 8 0 0">

			<Border Padding="12">

				<TextBlock
					x:Name="SampleTextBlock"
					Text="file.txt&#10;README.md&#10;写真.jpg&#10;フォルダー"
					TextWrapping="NoWrap"/>

			</Border>

		</GroupBox>
		-->
	</Grid>

</Window>
