<Window x:Class="ScrapRenamer.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

		xmlns:local="clr-namespace:ScrapRenamer"
		mc:Ignorable="d"
		AllowDrop="True"
		DragOver="OnDragOver"
		Drop="OnDrop"
		Title="MainWindow" Height="450" Width="800"
		ThemeMode="System">
	<DockPanel>

		<!-- メニューバー -->
		<Menu DockPanel.Dock="Top"
			Padding="4 0">
			<MenuItem Header="ファイル (_F)">
				<MenuItem
					Header="開く…  (_O)"
					Click="OnOpenMenuClick"/>
				<MenuItem
					Header="終了 (_X)"
					Click="OnExitMenuClick"/>
			</MenuItem>
			<MenuItem Header="設定…  (_S)"
					Click="OnOpenSettingsClick"/>
			<MenuItem Header="ヘルプ (_H)">
				<MenuItem
					Header="このアプリについて… (_A)"
					Click="OnOpenAboutClick"/>
			</MenuItem>
		</Menu>

		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0">
			<StackPanel Orientation="Horizontal">
				<Button Content="▶ 実行"
						Margin="2"
						Click="OnExecuteClicked"/>

				<Button Content="🗑 クリア"
						Margin="2"
						Click="OnClearClicked"/>

				<Button Content="ソート"
						Margin="2"
						Click="OnSortClicked"/>
			</StackPanel>
		</Border>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="24"/>
			</Grid.RowDefinitions>

			<wv2:WebView2
				Grid.Row="0"
				x:Name="EditorView"/>

			<Border
				Grid.Row="0"
				x:Name="DropOverlay"
				Visibility="Collapsed"
				Background="Transparent"
				AllowDrop="True"
				DragOver="OnDragOver"
				Drop="OnDrop">

				<Border
					CornerRadius="8"
					BorderThickness="2"
					BorderBrush="DodgerBlue"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="8,8">

					<TextBlock
						Text="ここにファイルをドロップ"
						FontSize="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</Border>
			</Border>

			<Border
				Grid.Row="1"
				x:Name="StatusBar"
				HorizontalAlignment="Stretch"
				BorderThickness="1"
				Padding="4 0">

				<TextBlock
					Text="ステータスバー"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"/>
			</Border>
		</Grid>
	</DockPanel>




</Window>
