{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-debug-x64",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"-c", "Debug",
				"-r", "win-x64",
				"${workspaceFolder}/ScrapRenamer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign",
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-release-x64",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"-c", "Release",
				"-r", "win-x64",
				"${workspaceFolder}/ScrapRenamer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish-x64",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"-c", "Release",
				"-r", "win-x64",
				"${workspaceFolder}/ScrapRenamer.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
	]
}
