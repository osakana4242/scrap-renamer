<Window x:Class="ScrapRenamer.View.OverwriteWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
		Title="ファイルの競合"
		Width="420"
		Height="190"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock
			TextWrapping="Wrap"
			Text="リネーム先に同名のファイルが存在します。&#10;&#10;このファイルを上書きしますか？"/>

		<CheckBox
			x:Name="ApplyToAllCheckBox"
			Grid.Row="1"
			Margin="0 16 0 0"
			Content="以降も同様の処理を行う"/>

		<StackPanel
			Grid.Row="2"
			Orientation="Horizontal"
			HorizontalAlignment="Right"
			Margin="0 20 0 0">

			<Button
				Width="90"
				Margin="0 0 8 0"
				Content="上書き"
				IsDefault="True"
				Click="OnOverwriteClicked"/>

			<Button
				Width="90"
				Margin="0 0 8 0"
				Content="スキップ"
				Click="OnSkipClicked"/>

			<Button
				Width="90"
				Content="キャンセル"
				IsCancel="True"
				Click="OnCancelClicked"/>

		</StackPanel>

	</Grid>

</Window>

