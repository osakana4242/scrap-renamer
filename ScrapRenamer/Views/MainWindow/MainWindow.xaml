<Window
	x:Class="ScrapRenamer.Views.MainWindow.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
	xmlns:SettingsWindow="clr-namespace:ScrapRenamer.Views.SettingsWindow"
	xmlns:MainWindow="clr-namespace:ScrapRenamer.Views.MainWindow"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	mc:Ignorable="d"
	Icon="pack://application:,,,/AppIcon/AppIcon.ico"
	AllowDrop="True"
	Title="{x:Static res:Strings.AppName}"
	Width="480"
	Height="560">
	<DockPanel>

		<!-- メニューバー -->
		<Menu DockPanel.Dock="Top"
			Padding="4 0">
			<MenuItem Header="{x:Static res:Strings.Menu_App}"
				x:Name="AppMenu">
				<MenuItem x:Name="Menu_OpenSettings"
					Header="{x:Static res:Strings.Menu_Settings}"/>

				<MenuItem x:Name="Menu_OpenAbout"
					Header="{x:Static res:Strings.Menu_Help_About}"/>

				<MenuItem x:Name="Menu_Quit"
					Header="{x:Static res:Strings.Menu_File_Quit}"/>
			</MenuItem>
			<MenuItem x:Name="RenameModeMenu"
				Header="{x:Static res:Strings.Menu_RenameMode}">
			</MenuItem>
		</Menu>

		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0">
			<DockPanel LastChildFill="False">
				<Button x:Name="ApplyButton"
						Content="{x:Static res:Strings.Button_Apply}"
						Margin="2"
						ToolTipService.InitialShowDelay="200"/>

				<Button x:Name="ResetButton"
						Content="{x:Static res:Strings.Button_Reset}"
						Margin="2"/>

				<Button x:Name="ClearButton"
						Content="{x:Static res:Strings.Button_Clear}"
						Margin="2"/>

				<Button x:Name="SortButton"
						Content="{x:Static res:Strings.Button_Sort}"
						Margin="2"/>
			</DockPanel>
		</Border>

		<!-- ドロップ or エディター領域 -->		
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="24"/>
			</Grid.RowDefinitions>

			<Border
				Grid.Row="0"
				x:Name="DropOverlay"
				AllowDrop="True">

				<Border
					CornerRadius="8"
					BorderThickness="2"
					BorderBrush="DodgerBlue"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="8,8">

					<TextBlock
						Text="{x:Static res:Strings.DropFilesHere}"
						FontSize="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</Border>
			</Border>

			<wv2:WebView2
				Grid.Row="0"
				x:Name="EditorView"/>


			<Border
				Grid.Row="1"
				x:Name="StatusBar"
				HorizontalAlignment="Left"
				BorderThickness="1"
				Padding="4 0">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock
						x:Name="StatusBarTextBlockLeft"
						Grid.Column="0"
						Text=""
						TextTrimming="CharacterEllipsis"/>

					<TextBlock
						x:Name="StatusBarTextBlockRight"
						Grid.Column="1"
						Text=""/>
				</Grid>

			</Border>
		</Grid>
	</DockPanel>



</Window>
