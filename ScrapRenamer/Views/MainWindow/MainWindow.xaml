<Window
	x:Class="ScrapRenamer.Views.MainWindow.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
	xmlns:SettingsWindow="clr-namespace:ScrapRenamer.Views.SettingsWindow"
	xmlns:MainWindow="clr-namespace:ScrapRenamer.Views.MainWindow"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	mc:Ignorable="d"
	Icon="pack://application:,,,/AppIcon/AppIcon.ico"
	AllowDrop="True"
	DragOver="OnDragOver"
	Drop="OnDrop"
	Title="{x:Static res:Strings.AppName}"
	Width="480"
	Height="560">
	<DockPanel>

		<!-- メニューバー -->
		<Menu DockPanel.Dock="Top"
			Padding="4 0">
			<MenuItem Header="{x:Static res:Strings.Menu_App}"
				x:Name="AppMenu">
				<MenuItem Header="{x:Static res:Strings.Menu_Settings}"
						Click="OnOpenSettingsClick"/>

				<MenuItem
					Header="{x:Static res:Strings.Menu_Help_About}"
					Click="OnOpenAboutClick"/>

				<MenuItem
					Header="{x:Static res:Strings.Menu_File_Quit}"
					Click="OnExitMenuClick"/>
			</MenuItem>
			<!--
			<MenuItem Header="{x:Static res:Strings.Menu_File}">
				<MenuItem
					Header="{x:Static res:Strings.Menu_File_Open}"
					Click="OnOpenMenuClick"/>
				<MenuItem
					Header="{x:Static res:Strings.Menu_File_Quit}"
					Click="OnExitMenuClick"/>
			</MenuItem>
			-->
			<MenuItem
				Header="{x:Static res:Strings.Menu_RenameMode}"
				x:Name="RenameModeMenu">
				<MenuItem
					Header="{x:Static res:Strings.RenameModeItems_FileName}"
					Tag="{x:Static MainWindow:RenameMode.FileName}"
					IsCheckable="True"
					Click="OnRenameModeMenuClick"/>

				<MenuItem
					Header="{x:Static res:Strings.RenameModeItems_FileNameWithoutExtension}"
					Tag="{x:Static MainWindow:RenameMode.FileNameWithoutExtension}"
					IsCheckable="True"
					Click="OnRenameModeMenuClick"/>

				<MenuItem
					Header="{x:Static res:Strings.RenameModeItems_FullPath}"
					Tag="{x:Static MainWindow:RenameMode.FullPath}"
					IsCheckable="True"
					Click="OnRenameModeMenuClick"/>
			</MenuItem>

			<!--
				<MenuItem
					Header="{x:Static res:Strings.Menu_Sort}">
					<MenuItem
						Header="{x:Static res:Strings.SortTypeItems_FileName}"
						Tag="{x:Static local:SortType.FileName}"
						Click="OnSortClicked"/>
					<MenuItem
						Header="{x:Static res:Strings.SortTypeItems_ExtensionFileName}"
						Tag="{x:Static local:SortType.ExtensionFileName}"
						Click="OnSortClicked"/>
					<MenuItem
						Header="{x:Static res:Strings.SortTypeItems_FullPath}"
						Tag="{x:Static local:SortType.FullPath}"
						Click="OnSortClicked"/>
					<MenuItem
						Header="{x:Static res:Strings.SortTypeItems_FullPathExtension}"
						Tag="{x:Static local:SortType.FullPathExtension}"
						Click="OnSortClicked"/>
				</MenuItem>
			-->

			<!--
			<MenuItem Header="{x:Static res:Strings.Menu_Help}">
				<MenuItem
					Header="{x:Static res:Strings.Menu_Help_About}"
					Click="OnOpenAboutClick"/>
			</MenuItem>
			-->
		</Menu>

		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0">
			<DockPanel LastChildFill="False">
				<Button Content="{x:Static res:Strings.Button_Apply}"
						Margin="2"
						Click="OnExecuteClicked"/>

				<Button Content="{x:Static res:Strings.Button_Reset}"
						Margin="2"
						Click="OnResetClicked"/>

				<Button Content="{x:Static res:Strings.Button_Clear}"
						Margin="2"
						Click="OnClearClicked"/>

				<Button Content="{x:Static res:Strings.Button_Sort}"
						Margin="2"
						Click="OnSortClicked"/>
			</DockPanel>
		</Border>
		
		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0"
				Visibility="Collapsed">
			<DockPanel LastChildFill="False">
				<TextBlock
					Text="{x:Static res:Strings.RenameModeComboBox_Label}"
					VerticalAlignment="Center"
					Margin="4,0,4,0" />

				<ComboBox
					x:Name="RenameModeComboBox"
					Width="180">
				</ComboBox>
			</DockPanel>
		</Border>

		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0"
				Visibility="Collapsed">
			<DockPanel LastChildFill="False">
				<TextBlock
					Text="{x:Static res:Strings.SortLabel}"
					VerticalAlignment="Center"
					Margin="4,0,4,0" />

				<Button Content="{x:Static res:Strings.Button_Sort_FileName}"
						Margin="2"
						Click="OnSortClicked"/>
			</DockPanel>
		</Border>

		<Border DockPanel.Dock="Top"
				BorderThickness="0 1 0 1"
				Padding="4 0"
				Visibility="Collapsed">
			<ListView>
				<ListView.View>
					<GridView>
						<GridViewColumn Header="ファイル名" />
						<GridViewColumn Header="種類" />
						<GridViewColumn Header="更新日時" />
					</GridView>
				</ListView.View>
			</ListView>		
		</Border>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="24"/>
			</Grid.RowDefinitions>

			<wv2:WebView2
				Grid.Row="0"
				x:Name="EditorView"/>

			<Border
				Grid.Row="0"
				x:Name="DropOverlay"
				Visibility="Collapsed"
				Background="Transparent"
				AllowDrop="True"
				DragOver="OnDragOver"
				Drop="OnDrop">

				<Border
					CornerRadius="8"
					BorderThickness="2"
					BorderBrush="DodgerBlue"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="8,8">

					<TextBlock
						Text="{x:Static res:Strings.DropFilesHere}"
						FontSize="24"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</Border>
			</Border>

			<Border
				Grid.Row="1"
				x:Name="StatusBar"
				HorizontalAlignment="Left"
				BorderThickness="1"
				Padding="4 0">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock
						x:Name="StatusBarTextBlockLeft"
						Grid.Column="0"
						Text=""
						TextTrimming="CharacterEllipsis"/>

					<TextBlock
						x:Name="StatusBarTextBlockRight"
						Grid.Column="1"
						Text=""/>
				</Grid>

			</Border>
		</Grid>
	</DockPanel>




</Window>
