<Window
	x:Class="ScrapRenamer.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	Icon="pack://application:,,,/AppIcon/AppIcon.ico"
	Title="{x:Static res:Strings.AboutWindow_Title}"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- アイコン + アプリ名 -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal">

			<Image
				Width="32"
				Height="32"
				Source="/AppIcon/AppIcon_x32.png"/>

			<StackPanel
				Margin="12 0 0 0"
				VerticalAlignment="Center">

				<TextBlock
					Text="ScrapRenamer"
					FontSize="20"
					FontWeight="SemiBold"/>

				<TextBlock
					x:Name="VersionText"
					Margin="0 4 0 0"
					Text="{x:Static res:Strings.AboutWindow_VersionFormat}"/>

			</StackPanel>

		</StackPanel>

		<!-- Copyright と GitHub -->
		<StackPanel Grid.Row="2">

			<TextBlock
				Text="{x:Static res:Strings.AboutWindow_Copyright}"/>

			<TextBlock Margin="0 8 0 0">

				<Hyperlink
					NavigateUri="#"
					RequestNavigate="OnRequestNavigate">
					<Run Text="{x:Static res:Strings.AboutWindow_RepositoryURL}" />
				</Hyperlink>

			</TextBlock>

		</StackPanel>

		<!-- ボタン -->
		<StackPanel
			Grid.Row="4"
			Orientation="Horizontal"
			HorizontalAlignment="Right">

			<Button
				Width="110"
				Margin="0 0 8 0"
				Content="{x:Static res:Strings.AboutWindow_CopyInfoButton}"
				Click="OnCopyClick"/>

			<Button
				Width="80"
				Content="{x:Static res:Strings.AboutWindow_OKButton}"
				IsDefault="True"
				IsCancel="True"
				Click="OnOkClick"/>

		</StackPanel>

	</Grid>

</Window>

