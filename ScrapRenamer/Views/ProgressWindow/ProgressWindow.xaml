<Window
	x:Class="ScrapRenamer.Views.ProgressWindow.ProgressWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	Title="{x:Static res:Strings.AppName}"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ProgressBar
			Grid.Row="0"
			Width="300"
			Height="4"
			IsIndeterminate="True" />

		<Button
			Grid.Row="1"
			Content="キャンセル"
			Margin="0,12,0,0"
			HorizontalAlignment="Center"
			Click="OnCancelClick" />
	</Grid>

</Window>

