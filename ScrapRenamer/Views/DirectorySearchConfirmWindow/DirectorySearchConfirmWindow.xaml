<Window
	x:Class="ScrapRenamer.DirectorySearchConfirmWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	Title="{x:Static res:Strings.AppName}"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			x:Name="MessageTextBlock"
			Grid.Row="0"
			Text=""
			Margin="0,0,0,20" />

		<Button
			Grid.Row="1"
			Content="{x:Static res:Strings.DirectorySearchConfirmWindow_CurrentDirectory}"
			MinWidth="260"
			Margin="0,0,0,8"
			Click="OnCurrentDirectoryClick" />

		<Button
			Grid.Row="2"
			Content="{x:Static res:Strings.DirectorySearchConfirmWindow_IncludeSubdirectories}"
			MinWidth="260"
			Click="OnIncludeSubdirectoriesClick" />
	</Grid>

</Window>
