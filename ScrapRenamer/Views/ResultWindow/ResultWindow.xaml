<Window
	x:Class="ScrapRenamer.Views.ResultWindow.ResultWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Icon="pack://application:,,,/AppIcon/AppIcon.ico"
	Title="結果"
    Width="320"
    Height="320"
    MinWidth="100"
    MinHeight="200"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- テキスト -->
		<RichTextBox
			x:Name="ResultTextBox"
			Grid.Row="0"
			IsReadOnly="True"
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Auto"
			>
			<FlowDocument>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
				<Paragraph>
					HogeHoge
					Fuga<Bold>Fuga</Bold>
					PiyoPiyo
				</Paragraph>
			</FlowDocument>
		</RichTextBox>

		<!-- ボタン -->
		<StackPanel
			Grid.Row="2"
			Orientation="Horizontal"
			HorizontalAlignment="Right">

			<Button
				Width="80"
				Content="OK"
				IsDefault="True"
				IsCancel="True"
				Click="OnOkClick"/>

		</StackPanel>

	</Grid>

</Window>

