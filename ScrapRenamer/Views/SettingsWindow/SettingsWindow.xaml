<Window
	x:Class="ScrapRenamer.Views.SettingsWindow.SettingsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:res="clr-namespace:ScrapRenamer.Localization.Strings"
	Icon="pack://application:,,,/AppIcon/AppIcon.ico"
	Title="{x:Static res:Strings.SettingsWindow_Title}"
	Width="400"
	Height="320"
	ResizeMode="CanResize"
	WindowStartupLocation="CenterOwner">

	<Grid Margin="16">
		<StackPanel>
			<StackPanel.Resources>
				<Style TargetType="Grid">
					<Setter Property="Margin" Value="0 6"/>
				</Style>
			</StackPanel.Resources>

			<!-- 言語 -->
			<StackPanel Margin="0 0 0 24">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="80"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						Text="{x:Static res:Strings.SettingsWindow_LanguageLabel}"/>

					<ComboBox x:Name="LanguageComboBox"
						Grid.Column="1" />
				</Grid>

				<TextBlock
					Margin="80 0 0 6"
					Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
					Text="{x:Static res:Strings.SettingsWindow_LanguageRestartNotice}"
					TextWrapping="Wrap"/>
			</StackPanel>

			<!-- テーマ -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static res:Strings.SettingsWindow_ThemeLabel}"/>

				<ComboBox x:Name="ThemeComboBox"
					Grid.Column="1" />
			</Grid>

			<!-- フォント -->
			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static res:Strings.SettingsWindow_FontFamilyLabel}"/>

				<ComboBox x:Name="FontFamilyComboBox"
					Grid.Column="1" />

			</Grid>

			<!-- サイズ -->
			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="80"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{x:Static res:Strings.SettingsWindow_FontSizeLabel}"/>

				<ComboBox x:Name="FontSizeComboBox"
					Grid.Column="1"
					IsEditable="True"/>

			</Grid>
		</StackPanel>
	</Grid>

</Window>
