<Window x:Class="ScrapRenamer.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

		xmlns:local="clr-namespace:ScrapRenamer"
		mc:Ignorable="d"
		AllowDrop="True"
		DragOver="OnDragOver"
		Drop="OnDrop"
		Background="{DynamicResource ControlBackgroundBrush}"
		Title="MainWindow" Height="450" Width="800">
	<DockPanel>

		<!-- メニューバー -->
		<Menu DockPanel.Dock="Top"
			Background="{DynamicResource ControlBackgroundBrush}"
			Foreground="{DynamicResource ControlForegroundBrush}">
			<MenuItem Header="_ファイル"/>
			<MenuItem Header="_設定"/>
			<MenuItem Header="_ヘルプ"/>
		</Menu>

		<!-- ツールバー -->
		<Border DockPanel.Dock="Top"
				Background="{DynamicResource ControlBackgroundBrush}">
			<StackPanel Orientation="Horizontal">
				<Button Content="▶ 実行"
						Margin="2"
						Click="OnExecuteClicked"/>

				<Button Content="🗑 クリア"
						Margin="2"
						Click="OnClearClicked"/>

				<Button Content="ソート"
						Margin="2"
						Click="OnSortClicked"/>
			</StackPanel>
		</Border>

		<Grid>
			<Grid.RowDefinitions>
			<!--
				<RowDefinition Height="80"/>
			-->
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<!--
				<Border
					Grid.Row="0"
					Margin="8"
					HorizontalAlignment="Stretch"
					BorderBrush="#808080"
					BorderThickness="2"
					CornerRadius="8"
					Background="#10FFFFFF"
					Padding="24">

					<TextBlock
						Text="ここにファイルをドラッグ＆ドロップ"
						Background="{DynamicResource ControlBackgroundBrush}"
						Foreground="{DynamicResource ControlForegroundBrush}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</Border>
			-->
			<wv2:WebView2
				Grid.Row="0"
				x:Name="EditorView"/>


			<Border
				Grid.Row="0"
				x:Name="DropOverlay"
				Visibility="Collapsed"
				Background="#80000000"
				AllowDrop="True"
				DragOver="OnDragOver"
				Drop="OnDrop">

				<Border
					Width="300"
					Height="120"
					CornerRadius="8"
					BorderThickness="2"
					BorderBrush="DodgerBlue"
					Background="#E0202020"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">

					<TextBlock
						Text="ここにファイルをドロップ"
						FontSize="24"
						Background="{DynamicResource ControlBackgroundBrush}"
						Foreground="{DynamicResource ControlForegroundBrush}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"/>
				</Border>
			</Border>


		</Grid>
	</DockPanel>

</Window>
