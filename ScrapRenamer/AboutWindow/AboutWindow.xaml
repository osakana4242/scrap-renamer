<Window
	x:Class="ScrapRenamer.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="このアプリについて"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	ThemeMode="System">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- アイコン + アプリ名 -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal">

			<Image
				Width="48"
				Height="48"
				Source="/Resources/AppIcon.png"/>

			<StackPanel
				Margin="12 0 0 0"
				VerticalAlignment="Center">

				<TextBlock
					Text="ScrapRenamer"
					FontSize="20"
					FontWeight="SemiBold"/>

				<TextBlock
					x:Name="VersionText"
					Margin="0 4 0 0"
					Text="バージョン 1.0.0"/>

			</StackPanel>

		</StackPanel>

		<!-- Copyright と GitHub -->
		<StackPanel Grid.Row="2">

			<TextBlock
				Text="Copyright © 2026 三川おさかな"/>

			<TextBlock Margin="0 8 0 0">

				<Hyperlink
					NavigateUri="https://github.com/osakana4242/scrap-renamer"
					RequestNavigate="OnRequestNavigate">
					https://github.com/osakana4242/scrap-renamer
				</Hyperlink>

			</TextBlock>

		</StackPanel>

		<!-- ボタン -->
		<StackPanel
			Grid.Row="4"
			Orientation="Horizontal"
			HorizontalAlignment="Right">

			<Button
				Width="110"
				Margin="0 0 8 0"
				Content="情報をコピー"
				Click="OnCopyClick"/>

			<Button
				Width="80"
				Content="OK"
				IsDefault="True"
				IsCancel="True"
				Click="OnOkClick"/>

		</StackPanel>

	</Grid>

</Window>

